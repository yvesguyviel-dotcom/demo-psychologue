---
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const faqs = [
  {
    question: "Comment se déroule le premier entretien ?",
    answer: "Le premier entretien permet de faire connaissance, d'aborder les motifs de votre démarche et d'évaluer ensemble la pertinence d'un accompagnement. C'est également l'occasion de poser toutes vos questions concernant le cadre des séances. Vous restez entièrement libre de poursuivre ou non à l'issue de cet échange."
  },
  {
    question: "Quelle est la durée et le rythme des séances ?",
    answer: "Chaque séance dure 45 minutes. Le rythme des consultations (hebdomadaire ou bimensuel) est défini conjointement lors des premiers rendez-vous en fonction de vos besoins et de vos disponibilités."
  },
  {
    question: "Qu'en est-il de la prise en charge des séances ?",
    answer: "Pour toute question sur la prise en charge, merci de contacter le cabinet lors de la prise de rendez-vous."
  },
  {
    question: "Comment est protégée la confidentialité des échanges ?",
    answer: "En tant que psychologue détentrice d'un titre protégé par la loi, je suis soumise au secret professionnel (article 226-13 du Code pénal) et au Code de déontologie des psychologues. L'intégralité de ce qui est évoqué au sein du cabinet demeure confidentiel."
  }
];
---

<section id="faq" class="py-20 md:py-28 bg-surface border-t border-b border-border" data-ps="src/components/home/Faq.astro:section">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start" data-ps="src/components/home/Faq.astro:9riuus">
      <!-- Left column (5/12) -->
      <div class="lg:col-span-5" data-ps="src/components/home/Faq.astro:9riuur">
        <div class="inline-flex items-center gap-2 mb-3 text-xs font-medium tracking-wider uppercase text-primary" data-ps="src/components/home/Faq.astro:9riuuq">
          <span data-ps="src/components/home/Faq.astro:dfjk08">Questions fréquentes</span>
        </div>
        <h2 class="font-display font-serif text-3xl md:text-4xl font-normal tracking-tight text-foreground mb-4" data-ps="src/components/home/Faq.astro:gfvd3h">
          Foire aux questions
        </h2>
        <p class="text-base text-muted-foreground leading-relaxed mb-6" data-ps="src/components/home/Faq.astro:i9lioa">
          Des réponses claires et précises aux interrogations les plus régulières concernant le cadre de consultation et l'accompagnement psychologique.
        </p>
        <div class="p-5 rounded-md bg-background border border-border" data-ps="src/components/home/Faq.astro:9riuup">
          <p class="text-xs text-muted-foreground m-0 leading-relaxed" data-ps="src/components/home/Faq.astro:i9liob">
            Pour toute question spécifique n'apparaissant pas ci-contre, vous pouvez contacter directement le cabinet par téléphone ou par courriel.
          </p>
        </div>
      </div>

      <!-- Right column (7/12) Accordion items -->
      <div class="lg:col-span-7 divide-y divide-border" data-ps="src/components/home/Faq.astro:9riuuo">
        {faqs.map((faq, index) => (
          <details class="group py-5 first:pt-0 last:pb-0" open={index === 0}>
            <summary class="flex justify-between items-center cursor-pointer list-none text-foreground font-serif font-medium text-lg group-open:text-primary transition-colors focus:outline-none">
              <span data-ps={`src/components/home/Faq.astro:dfjk07-${index}`}>{faq.question}</span>
              <span class="ml-4 text-muted-foreground group-open:rotate-180 transition-transform text-xs" data-ps={`src/components/home/Faq.astro:u7xopd-${index}`}>
                ▼
              </span>
            </summary>
            <p class="mt-3 text-sm text-muted-foreground leading-relaxed m-0 pr-6" data-ps={`src/components/home/Faq.astro:i9lioc-${index}`}>
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </Container>
</section>
